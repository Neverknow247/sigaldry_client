;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deckmaster Master"
config/version="0.000.001"
run/main_scene="uid://sdqjb15ql8mj"
config/use_custom_user_dir=true
config/custom_user_dir_name="Deckmaster"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/art/icon.svg"

[autoload]

